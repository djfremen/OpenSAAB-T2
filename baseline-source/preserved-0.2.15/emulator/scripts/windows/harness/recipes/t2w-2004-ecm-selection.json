{
  "description": "Saab 9.250 2004 9440. Start at Main Menu, F0 selected. Private reference templates required. Ends with ECM highlighted, without pressing Enter. Not yet validated end-to-end on this harness.",
  "steps": [
    {
      "label": "Open Diagnostics",
      "expect": {
        "template": "t2w-main",
        "client": true,
        "crop": [
          0,
          0,
          480,
          360
        ],
        "tolerance": 0.004,
        "timeout": 25
      },
      "action": {
        "sequence": [
          {
            "key": "ENTER"
          }
        ]
      },
      "after": {
        "template": "t2w-year-2012",
        "client": true,
        "crop": [
          0,
          0,
          480,
          360
        ],
        "tolerance": 0.004,
        "timeout": 25
      }
    },
    {
      "label": "Select model year 2004",
