        "client": true,
        "crop": [
          0,
          0,
          480,
          360
        ],
        "tolerance": 0.004,
        "timeout": 25
      },
      "action": {
        "sequence": [
          {
            "key": "DOWN",
            "count": 8
          },
          {
            "key": "ENTER"
          }
        ]
      },
