# Required: the exact image digest currently serving this deployment.
# Inherit its collector entrypoint, API/password gates and website unchanged.
ARG OPENSAAB_SUPPORT_BASE_IMAGE
FROM ${OPENSAAB_SUPPORT_BASE_IMAGE}
ARG OPENSAAB_SUPPORT_VERSION
ARG OPENSAAB_SUPPORT_SOURCE_REVISION
LABEL org.opencontainers.image.title="OpenSAAB support API" \
      org.opencontainers.image.version="${OPENSAAB_SUPPORT_VERSION}" \
      org.opencontainers.image.revision="${OPENSAAB_SUPPORT_SOURCE_REVISION}"
COPY support_reports_api.py /app/support_reports_api.py
